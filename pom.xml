<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.backline.test</groupId>
    <artifactId>maven-jfrog-private-test</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Maven JFrog Private-Artifact Test</name>
    <description>
        BKLN-2092 end-to-end test repo. Depends on com.backline.test:demo-lib:1.0.0
        which lives in the backlineai.jfrog.io maven-test virtual repo. demo-lib
        transitively pulls in log4j-core 2.14.1 (CVE-2021-44228, Log4Shell), so
        a Trivy/SCA scan of this project surfaces a CRITICAL finding that Backline
        SCA Planning will try to remediate. Resolving demo-lib's effective POM
        requires authenticating against JFrog — the runner's
        JFrogRegistryMavenPackageRegistryHandler injects ~/.m2/settings.xml
        with a Bearer token, then mvn / Gradle resolve through the maven-test
        virtual repo.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Scoped override: demo-lib:1.0.0 transitively pulls log4j-core 2.14.1
                 (CVE-2021-44228, Log4Shell). No available version of demo-lib within
                 its current major (1.x) brings in a fixed log4j-core, and the only
                 other published demo-lib version (2.0.0) only raises it to 2.17.1,
                 which is still below the required fix floor. Force log4j-core to the
                 patched 2.25.4 (same major line, GA release) via a scoped
                 dependencyManagement pin, scoped only to the vulnerable library's own
                 artifact. -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>2.25.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.backline.test</groupId>
            <artifactId>demo-lib</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
</project>
